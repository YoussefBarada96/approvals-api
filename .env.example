# Copy to .env for local development. Docker Compose sets these itself.
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://approvals:approvals@localhost:5432/approvals
# Required whenever APP_ENV isn't development. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=30
